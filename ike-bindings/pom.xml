<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
    </parent>

    <artifactId>ike-bindings</artifactId>
    <packaging>jar</packaging>

    <name>Ike Bindings</name>
    <description>
        Generated bindings for the IkeFoundation knowledge set: resolved UUID literals with
        definitions as javadoc, autocompletable in any IDE. Depends only on the
        terms surface, so consumers stay light.
    </description>

    <!-- Dual licensed (IKE-Network/ike-issues#952); identical in every POM of
         this reactor. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>terms</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>common</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <!-- The ledger this module generates from — optional, never propagated. -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-terms</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- The knowledge-pipeline implementation, resolved by ServiceLoader inside
             the goal's forked seam — optional, never propagated: a consumer of the
             bindings needs the terms surface only, and this version is the reactor's. -->
        <dependency>
            <groupId>network.ike.knowledge</groupId>
            <artifactId>ike-knowledge-provider</artifactId>
            <version>${ike-knowledge-provider.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-knowledge-bindings</id>
                        <goals>
                            <goal>knowledge-bindings</goal>
                        </goals>
                        <configuration>
                            <packageName>network.ike.foundation.ike.bindings</packageName>
                            <className>IkeTerms</className>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The generated constants have no module descriptor yet (the bindings goal
                 will grow one with the enum emitter, IKE-Network/ike-issues#1111); until
                 then the jar names itself so modular consumers can require it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>network.ike.foundation.ike.bindings</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
