<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
    </parent>
    <artifactId>ike-elm</artifactId>
    <packaging>jar</packaging>
    <name>Ike ELM Trees</name>
    <description>
        How ELM logic is held in IKE (IKE-Network/ike-issues#1110): the catalog of ELM node
        kinds read back from the store, one generic builder and checker driven by it, the
        three ELM enumerations as bound Java enums, and the writer that records a library
        as one semantic per definition. HL7's ELM is the Expression Logical Model of the
        Clinical Quality Language specification, not the Elm programming language.
    </description>
    <!-- Dual licensed (IKE-Network/ike-issues#952); identical in every POM of
         this reactor. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-bindings</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-writer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-ucum</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The ledger, composed into an ephemeral store by the integration tests. -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-terms</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-fixtures</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>network.ike.knowledge</groupId>
            <artifactId>ike-knowledge-provider</artifactId>
            <version>${ike-knowledge-provider.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- The gates are integration tests (*IT): they boot an ephemeral store and
                 compose the ledger into it, as ike-terms's gates do. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>
                        --enable-preview
                        --enable-native-access=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.io=ALL-UNNAMED
                    </argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
