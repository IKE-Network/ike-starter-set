<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
    </parent>
    <artifactId>ike-writer</artifactId>
    <packaging>jar</packaging>
    <name>Ike Store Writer</name>
    <description>
        Writing knowledge into the running store from code, as the ledger does at replay:
        stamps, concepts with their stated parents, version-aware semantics that append
        only when content changed, descriptions with their dialects, and retirement. The
        importers of ELM libraries and of UCUM units record through it
        (IKE-Network/ike-issues#1112, #1114).
    </description>
