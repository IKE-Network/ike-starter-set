<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
    </parent>
    <artifactId>ike-evaluate</artifactId>
    <packaging>jar</packaging>
    <name>Ike Evaluation</name>
    <description>
        Evaluation over statement sets (IKE-Network/ike-issues#1116): the values of IKE's own
        kinds, the evaluator that walks a stored library's trees and takes each node kind to
        the construct a checked relation admits, the statement source seam, the bridge from a
        retrievable class to a criterion, and the gates over the CQL test suite and the corpus.
    </description>
    <!-- Dual licensed (IKE-Network/ike-issues#952); identical in every POM of
         this reactor. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-bindings</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-writer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-ucum</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-elm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The ledger, composed into an ephemeral store by the integration tests. -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-terms</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-fixtures</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>network.ike.knowledge</groupId>
            <artifactId>ike-knowledge-provider</artifactId>
            <version>${ike-knowledge-provider.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>
                        --enable-preview
                        --enable-native-access=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.io=ALL-UNNAMED
                    </argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
